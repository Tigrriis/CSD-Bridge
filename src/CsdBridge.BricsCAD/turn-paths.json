  "default_vehicle": "B99",

  // Drawing units: "auto" reads the drawing's INSUNITS (millimetres, centimetres, metres, feet...)
  // and takes metres when it isn't set; "m" or "mm" overrides it. Every length in this file, and in
  // the dialogs, stays in metres whatever the drawing is drawn in.
  "drawing_units": "auto",

  // Simulation: step along the path (m) and the tolerance the drawn polylines are simplified to (m).
  "step": 0.02,
  "tolerance": 0.001,

  // Template turns: straight travel before and after the arc (m).
  "lead_in": 0,
  "lead_out": 6,

  // Drive mode: "arc" = one arc to each destination when its radius allows (otherwise a turn at the
  // radius then straight); "corner" = always a turn at the radius then straight.
  "drive_turns": "arc",
  // Drive mode: also ask which way the vehicle faces at each destination (turn, straight, turn).
  "drive_arrival_heading": false,

  // Conflict check: flag where the swept path (a hit) or its clearance (an encroachment) meets
  // linework on these layers. * and ? are wildcards; "A-WALL*" also matches xref layers such as
  // "arch|A-WALL-EXT". Blank with check_conflicts on = pick objects on the layers when prompted.
  "check_conflicts": false,
  "obstruction_layers": [],

  // Solve mode (multi-point turns between the obstruction layers): how long the search may take
  // (seconds), and how far beyond the start and target positions the vehicle may go while
  // manoeuvring (m). Linework further away than that is ignored.
  "solver_time_limit": 10,
  "solver_search_margin": 15,

  // Vehicle outlines every this many metres along the path (0 = only at the start and end).
  "outline_interval": 0,

  // Label text height in metres, 0.3 = 300 in a millimetre drawing (null = the drawing's default).
  "text_height": 0.3,

  // Ground clearance check (AICLEARANCE): template step along a section, position interval along a
  // path on a surface, and the default vertical exaggeration of long section plots.
  "clearance_step": 0.05,
  "clearance_pose_interval": 0.1,
  "section_vertical_exaggeration": 1,

  "draw": {
    "swept_path": true,
    "clearance": true,
    "vehicle": true,
    "path": true,
    "wheel_paths": false,
    "labels": true,
    "hatch": false,
    "closed_outline": false,
    // Gather everything drawn into one block, named "<vehicle> turning path", inserted at the
    // vehicle's start point on the block layer. The entities keep their layers inside the block.
    "block": false
  },

  "layers": {
    "swept_path": "AE CIV PLN - VEHICLE SWEPT PATH",
    "clearance": "AE CIV PLN - VEHICLE CLEARANCE",
    "vehicle": "AE CIV PLN - VEHICLE OUTLINE",
    "vehicle_intermediate": "AE CIV PLN - VEHICLE OUTLINE INTERMEDIATE",
    "path": "AE CIV PLN - VEHICLE PATH",
    "wheel_paths": "AE CIV PLN - VEHICLE WHEEL PATHS",
    "labels": "AE CIV PLN - VEHICLE TEXT",
    "hatch": "AE CIV HTC - VEHICLE SWEPT PATH",
    "block": "AE CIV PLN - VEHICLE BLOCK",
    "conflict": "AE CIV PLN - VEHICLE CONFLICT",
    "clearance_check": "AE CIV PLN - VEHICLE GROUND CLEARANCE",
    "clearance_fail": "AE CIV PLN - VEHICLE GROUND CLEARANCE FAIL"
