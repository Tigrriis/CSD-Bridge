<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Makes sure nuget.org is a package source when building this repo, even on
    machines whose own NuGet settings have no sources (restore then fails with
    "NU1100: Unable to resolve 'Anthropic'"). Any other sources set up on the
    machine, such as an office package feed, still apply.

    If nuget.org has been disabled on the machine, re-enable it with:
      dotnet nuget enable source nuget.org
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
